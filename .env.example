# URL backend. Kosongkan untuk mode demo lokal (data di memori browser, hilang saat refresh).
#
# Supabase (backend saat ini; sudah diisi di .env.production untuk `npm run build`):
#   VITE_API_URL=https://<project-ref>.supabase.co/functions/v1/api
# Alternatif lama (Google Apps Script): URL Web app hasil Deploy, berakhiran /exec.
#   VITE_API_URL=https://script.google.com/macros/s/XXXX/exec
VITE_API_URL=

# Opsional. Harus sama dengan secret API_KEY di Supabase (Edge Function) atau Script Property API_KEY di Apps Script.
# Biarkan kosong jika API_KEY tidak dipasang di server.
VITE_API_KEY=
