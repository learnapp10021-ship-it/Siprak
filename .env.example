# URL backend. Kosongkan untuk mode demo lokal (data di memori browser, hilang saat refresh).
# Contoh Google Apps Script (hasil Deploy > Web app, berakhiran /exec):
#   VITE_API_URL=https://script.google.com/macros/s/XXXX/exec
VITE_API_URL=

# Opsional. Harus sama dengan Script Property API_KEY di server. Biarkan kosong jika API_KEY tidak dipasang.
VITE_API_KEY=
